# ============================================================
# Atlas configuration. Copy this file to `.env` and fill in.
#   PowerShell:  Copy-Item .env.example .env
# `.env` is gitignored — never commit real keys.
# ============================================================

# ---- Server ----
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000
ATLAS_RELOAD=true

# ---- Ollama (local models) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# ---- Optional API model providers (leave blank to disable) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Email assistant (fill in when you build that feature) ----
# Use an app-specific password, NOT your real password.
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=
