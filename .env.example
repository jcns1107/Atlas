# ============================================================
# Atlas configuration. Copy this file to `.env` and fill in.
#   PowerShell:  Copy-Item .env.example .env
# `.env` is gitignored — never commit real keys.
# ============================================================

# ---- Server ----
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000
ATLAS_RELOAD=true

# ---- Ollama (local models) ----
OLLAMA_BASE_URL=http://localhost:11434
# A small model with tool calling + "thinking". Small PC? try qwen3:1.7b.
OLLAMA_DEFAULT_MODEL=qwen3:4b
# Turns text into vectors for RAG (Phase 6): `ollama pull embeddinggemma`
OLLAMA_EMBED_MODEL=embeddinggemma
# Context window (in tokens) to request on each call. Ollama's own default is
# small (~4k) and it SILENTLY drops anything past it — set it explicitly.
OLLAMA_NUM_CTX=8192
# A Jev-style "decision model" for yes/no, pick-one and score questions
# (Phase 8). Check the current tag on ollama.com/library.
OLLAMA_DECISION_MODEL=nimble

# ---- Optional API model providers (leave blank to disable) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Hosted Jev decision model by TypeSafe (optional; the local one is enough to learn)
JEV_API_KEY=

# ---- Email assistant (fill in when you build that feature) ----
# Use an app-specific password, NOT your real password.
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=
